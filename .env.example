# https://my.telegram.org -> API
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Каналы через запятую: @name, name, https://t.me/name или -100…
SOURCE_CHANNELS=@channel_one,@channel_two

# Ваш канал для уведомлений
TARGET_CHANNEL=@my_channel

DATA_DIR=data
SAVE_MEDIA=true
MAX_MEDIA_MB=20
MEDIA_KEEP_DAYS=7
BACKFILL_LIMIT=50
CHECK_INTERVAL_MIN=30
CHECK_DAYS=3
REPORT_UNKNOWN=false
TZ_OFFSET=3

# Подпись в конце уведомления
SIGNATURE=это автоматическое сообщение бота @my_channel
